{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "hp": {
      "default": {},
      "type": "object",
      "properties": {
        "current": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "temp": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "hit_dice_spent": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "death_saves": {
      "default": {},
      "type": "object",
      "properties": {
        "successes": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "failures": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "stable": {
      "default": false,
      "type": "boolean"
    },
    "dead": {
      "default": false,
      "type": "boolean"
    },
    "exhaustion": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "conditions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concentration": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "active": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heroic_inspiration": {
      "default": false,
      "type": "boolean"
    },
    "spell_slots_spent": {
      "default": [],
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "pact_slots_spent": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uses_spent": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "choices": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "inventory": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "base": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "variant": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "qty": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "equipped": {
            "default": false,
            "type": "boolean"
          },
          "attuned": {
            "default": false,
            "type": "boolean"
          },
          "charges_spent": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "notes": {
            "default": "",
            "type": "string"
          },
          "location": {
            "type": "string",
            "const": "stored"
          }
        },
        "required": [
          "id",
          "item"
        ]
      }
    },
    "currency": {
      "default": {},
      "type": "object",
      "properties": {
        "cp": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sp": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ep": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gp": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pp": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "next_item": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "starting_equipment": {
      "type": "boolean"
    }
  },
  "title": "Character play state"
}
