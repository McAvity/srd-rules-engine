{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MovePreview",
  "$defs": {
    "MovePreview": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pending_decision",
              "halted",
              "not_started",
              "not_your_turn",
              "incapacitated",
              "defeated",
              "economy_used",
              "no_attacks_left",
              "once_per_turn",
              "out_of_range",
              "off_map",
              "total_cover",
              "no_path",
              "no_movement",
              "no_resources",
              "unknown",
              "incomplete",
              "refused"
            ]
          }
        },
        "reason_messages": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "path": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "movement_left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zone": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "creature": {
                "type": "string"
              },
              "at": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "kind": {
                "type": "string",
                "enum": [
                  "enters",
                  "moves_in"
                ]
              },
              "feet": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "zone",
              "label",
              "creature",
              "at",
              "kind",
              "feet"
            ],
            "additionalProperties": false
          }
        },
        "opportunity_attacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "turns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ok",
        "reasons",
        "codes",
        "reason_messages",
        "path",
        "cost",
        "movement_left",
        "zones",
        "opportunity_attacks",
        "turns"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "params",
        "text"
      ],
      "additionalProperties": false
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Message"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "title": "Move preview"
}
